<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">
    <FrameLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_page_background">
        <ScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/headerArtwork"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/home_header_art"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/home_header_fade"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="22dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageButton
                                android:id="@+id/hamburger_button"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/home_round_button"
                                android:padding="13dp"
                                android:contentDescription="@string/home_open_menu"
                                android:src="@drawable/ic_ph_list"
                                app:tint="@color/homepage_blue" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/scanButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/home_round_button"
                                android:padding="12dp"
                                android:contentDescription="@string/home_scan"
                                android:src="@drawable/ic_ph_qr_code"
                                app:tint="@color/homepage_blue" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="136dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="24dp"
                                android:paddingTop="16dp"
                                android:paddingBottom="42dp">
                                <TextView
                                    android:id="@+id/userInfoTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/homepage_text"
                                    android:textSize="20sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:visibility="gone"
                                    tools:visibility="visible"
                                    tools:text="饶晨煜 - ZY2623327" />

                                <TextView
                                    android:id="@+id/academyTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/homepage_secondary"
                                    android:textSize="15sp"
                                    android:visibility="gone"
                                    tools:visibility="visible"
                                    tools:text="国家卓越工程师学院" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/home_panel"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_ph_calendar_blank"
                            app:tint="@color/homepage_blue"
                            android:importantForAccessibility="no" />

                        <TextView style="@style/Home.SectionTitle" android:text="@string/home_choose_date" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/datePickerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/home_date_background"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_ph_calendar_blank"
                            app:tint="@color/homepage_blue"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/textViewDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:textColor="@color/homepage_text"
                            android:textSize="18sp"
                            tools:text="2026-09-09" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/home_ic_chevron"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetClass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/home_action_background"
                        app:backgroundTint="@null"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp"
                        android:text="@string/home_query"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        app:icon="@drawable/home_ic_arrow"
                        app:iconGravity="textEnd"
                        app:iconPadding="12dp"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/home_panel"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="6dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/home_ic_book"
                            android:importantForAccessibility="no" />

                        <TextView
                            style="@style/Home.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/home_courses" />

                        <TextView
                            android:id="@+id/courseCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/home_count_background"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:textColor="@color/homepage_secondary"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="共 4 门课程" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/courseList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/loadingState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="240dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">
                        <ProgressBar
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:indeterminateTint="@color/homepage_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/home_loading"
                            android:textColor="@color/homepage_secondary"
                            android:textSize="15sp"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/emptyStateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="340dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="32dp"
                        android:visibility="gone"
                        tools:visibility="visible">
                        <!-- Replace home_empty_art with transparent empty-state artwork. -->

                        <ImageView
                            android:id="@+id/emptyArtwork"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:src="@drawable/home_empty_art"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/resultStateTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/home_empty_title"
                            android:textColor="@color/homepage_text"
                            android:textSize="21sp" />

                        <TextView
                            android:id="@+id/resultStateDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/home_empty_description"
                            android:textColor="@color/homepage_secondary"
                            android:textSize="15sp"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="284dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_container"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical">
        <include android:id="@+id/drawer_header" layout="@layout/drawer_header" />

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:itemBackground="@drawable/bg_drawer_item_selector"
            app:itemHorizontalPadding="20dp"
            app:itemIconPadding="16dp"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/drawer_icon_color_selector"
            app:itemTextAppearance="@style/DrawerItemTextAppearance"
            app:itemTextColor="@color/drawer_item_color_selector"
            app:menu="@menu/drawer_menu" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/home_card_border" />

        <include android:id="@+id/drawer_footer" layout="@layout/drawer_footer" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
